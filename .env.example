# VYBE — copy to .env and fill in. .env is gitignored; never commit it.

# Deepgram — streaming ASR (Nova-3). https://console.deepgram.com
DEEPGRAM_API_KEY=

# ElevenLabs — expressive TTS (eleven_v3). https://elevenlabs.io
# A Creator plan or above unlocks library voices and 5 concurrent renders.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# LLM — any OpenAI-compatible endpoint (ADR-008)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=

# Sarvam — optional, only for the earlier Bulbul TTS experiments in scripts/
SARVAM_API_KEY=
